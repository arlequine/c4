# Copia a .env (no se sube al repo). Las variables exportadas en la terminal tienen prioridad.
ANTHROPIC_API_KEY=sk-ant-...

# Modelo por etapa (formato proveedor/modelo de CrewAI). Estos son los valores por defecto:
QA_MODEL_REVISOR=anthropic/claude-opus-5-5
QA_MODEL_PLAN=anthropic/claude-opus-5-5
QA_MODEL_PRUEBAS=anthropic/claude-haiku-5-5
QA_MODEL_DEV=anthropic/claude-sonnet-5-5
QA_MODEL_EJECUTOR=anthropic/claude-opus-5-5

# Proyecto bajo prueba, relativo a qa-crew/
QA_E2E_DIR=../qa-e2e
BASE_URL=http://localhost:3000
